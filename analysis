# --- 1. THE REFINED MAIN FUNCTION ---
create_op_panel_final <- function(data, var_name, display_label, y_limit) {
  
  # A. calc TRUE MEDIANS from the full dataset
  median_hot <- data %>% 
    dplyr::filter(!is.na(.data[[var_name]]), hi90 == 1) %>% 
    dplyr::summarise(m = median(.data[[var_name]], na.rm = TRUE)) %>% 
    dplyr::pull(m)
    
  median_nothot <- data %>% 
    dplyr::filter(!is.na(.data[[var_name]]), hi90 == 0) %>% 
    dplyr::summarise(m = median(.data[[var_name]], na.rm = TRUE)) %>% 
    dplyr::pull(m)

  # B. data
  plot_df <- data %>%
    dplyr::filter(!is.na(.data[[var_name]]), .data[[var_name]] <= y_limit) %>%
    mutate(dummy_x = display_label)

  # C. plot
  ggplot(plot_df, aes_string(x = "dummy_x", y = var_name, fill = "hi90_max")) +
    geom_split_violin(alpha = 0.9, color = "black", size = 0.5) +
    
    # annotate min labels
    annotate("text", x = 0.78, y = y_limit * 0.55, 
             label = paste0(round(median_nothot, 0), " min"), 
             color = "#203463", fontface = "bold", size = 8.25, family = "Helvetica") +
    
    annotate("text", x = 1.22, y = y_limit * 0.55, 
             label = paste0(round(median_hot, 0), " min"), 
             color = "#FF9933", fontface = "bold", size = 8.25, family = "Helvetica") +
    
    scale_fill_manual(
      values = c("HImax < 90\u00b0F" = "#203463", "HImax \u2265 90\u00b0F" = "#FF9933"), 
      name = NULL
    ) +
    scale_y_continuous(limits = c(0, y_limit), expand = c(0, 0)) +
    
    labs(y = "Minutes", x = NULL) +
    theme_minimal() +
    theme(
      text = element_text(family = "Helvetica", color = "black"),
      axis.text.y = element_text(size = 18), 
      axis.title.y = element_text(size = 20, face = "bold"),
      axis.text.x = element_text(size = 24, face = "bold"),
      legend.position = "bottom",
      panel.grid.major.x = element_blank(),
      axis.line.y = element_line(color = "black", size = 1.0)
    )
}

# --- 2. MAKE PANELS ---
p1 <- create_op_panel_final(d_warm2, "doortodoc", "Door-to-Doc", 300)
p2 <- create_op_panel_final(d_warm2, "doctodecision", "Doc-to-Decision", 1000)
p3 <- create_op_panel_final(d_warm2, "boarding", "Boarding Time", 1500)
p4 <- create_op_panel_final(d_warm2, "los", "Total ED LOS", 2500)

# --- 3. COMBINE AND THEN THE LEGEND ---
figure_3_ultra_vis <- (p1 + p2) / (p3 + p4) + 
  plot_layout(guides = "collect") & 
  theme(
    legend.position = "bottom",
    legend.title = element_blank(),
    legend.text = element_text(size = 26), 
    legend.key.size = unit(3, "lines"),
    legend.margin = margin(t = 20)
  )

# save
ggsave("Figure3_Final_Rounded_Minimalist_NSB.png", figure_3_ultra_vis, width = 14, height = 18, dpi = 600, bg = "white")

