# Creating a combined multipanel figure of the dists
```{r multipanel-distributions}
# Function with increased font sizes and axis title buffering
create_op_plot_high_res <- function(data, var, label, x_limit) {
  
  # calc total n before filtering
  n_true <- sum(!is.na(data[[var]]))
  
  # calc median from full dataset before filtering
  median_val <- median(data[[var]], na.rm = TRUE)
  
  # data filter to clean fig
  plot_data <- data %>% 
    filter(!is.na(.data[[var]]), .data[[var]] <= x_limit)
  
  ggplot(plot_data, aes_string(x = var)) +
    geom_density(na.rm = TRUE, fill = "black", color = "black", alpha = 0.85) +
    
    # median labeling
    annotate("text", 
             x = x_limit * 0.75, 
             y = Inf, 
             label = paste0("Median: ", round(median_val, 0), " min"),
             color = "black",
             fontface = "bold", 
             size = 8,
             family = "Helvetica",
             vjust = 3.5,
             hjust = 0.5) +
    
    scale_x_continuous(limits = c(0, x_limit), expand = c(0, 0)) + 
    scale_y_continuous(expand = expansion(mult = c(0, 0.05))) +
    
    labs(
      subtitle = paste0(label, " (Total n = ", format(n_true, big.mark=","), ")"),
      x = "Time (minutes)",
      y = NULL
    ) +
    
    theme_minimal() +
    theme(
      text = element_text(family = "Helvetica", color = "black"),
      panel.grid.major.x = element_line(color = "grey92"),
      panel.grid.minor = element_blank(),
      panel.grid.major.y = element_blank(),
      axis.text.y = element_blank(),
      axis.ticks.y = element_blank(),
      axis.line.x = element_line(color = "black", size = 0.8),
      axis.line.y = element_line(color = "black", size = 0.8),
      plot.subtitle = element_text(face = "bold", size = 22, color = "black"),
      axis.text.x   = element_text(size = 20, color = "black"),
      axis.title.x  = element_text(
        size = 20, 
        color = "black", 
        face = "bold", 
        margin = margin(t = 15)
      ),
      plot.margin = margin(10, 40, 10, 20) 
    )
}

# make panels fig
p1 <- create_op_plot_high_res(d_warm2, "doortodoc", "Door-to-Doc", 300)
