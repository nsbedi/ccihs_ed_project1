This first set of models uses HI as a continuous variable and adjusts for age and sex as well.

```{r gamma-the-sequel}
# Door2Doc Model 1 (adjusted for age and sex)
m_dtd_gamma <- glm(
  doortodoc_g ~ HImax_F + age + sex + dow + month * year,
  data   = d_warm2,
  family = Gamma(link = "log")
)

summary(m_dtd_gamma)

# Doc to Decision Model 1 (adjusted for age and sex)
m_doctodecision_gamma <- glm(
  doctodecision_g ~ HImax_F + age + sex + dow + month * year,
  data   = d_warm2,
  family = Gamma(link = "log")
)

summary(m_doctodecision_gamma)

# Boarding Model 1 (adjusted for age and sex)
m_boarding_gamma <- glm(
  boarding_g ~ HImax_F + age + sex + dow + month * year,
  data   = d_warm2,
  family = Gamma(link = "log")
)

summary(m_boarding_gamma)

# LOS Model 1 (adjusted for age and sex)
m_los_gamma <- glm(
  los_g ~ HImax_F + age + sex + dow + month * year,
  data   = d_warm2,
  family = Gamma(link = "log")
)

summary(m_los_gamma)
```

And the coefficients and CIs again:

```{r sequel-gamma-coeffs-cis}
# Coefficients in the Gamma cont HI models
beta_HI_doortodoc     <- coef(m_dtd_gamma)["HImax_F"]
exp(beta_HI_doortodoc)

beta_HI_doctodecision <- coef(m_doctodecision_gamma)["HImax_F"]
exp(beta_HI_doctodecision)

beta_HI_boarding      <- coef(m_boarding_gamma)["HImax_F"]
exp(beta_HI_boarding)

beta_HI_los           <- coef(m_los_gamma)["HImax_F"]
exp(beta_HI_los)

# Confidence Intervals in the Gamma cont HI models
ci_doortodoc     <- confint.default(m_dtd_gamma, "HImax_F")
exp(ci_doortodoc)

ci_doctodecision <- confint.default(m_doctodecision_gamma, "HImax_F")
exp(ci_doctodecision)

ci_boarding      <- confint.default(m_boarding_gamma, "HImax_F")
exp(ci_boarding)

ci_los           <- confint.default(m_los_gamma, "HImax_F")
exp(ci_los)
```

